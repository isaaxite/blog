{
  "name": "gh-pages",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "clean": "hexo clean",
    "generate": "hexo clean && hexo generate",
    "deploy": "hexo g -d",
    "push+deploy": "git push origin main && npm run deploy",
    "server": "hexo clean && hexo server",
    "server+draft": "hexo clean && hexo server --draft",
    "new-daily": "node ./npm-scripts/new.js daily",
    "new-draft": "hexo new draft",
    "migrate-drafts": "migrate-cli -a assets -b ../ -i blog/source/_drafts -o blog/source/_posts",
    "migrate-posts": "migrate-cli  -a assets -b ../ -i blog/source/_posts -o blog/source/_drafts",
    "find-unreferenced-assets": "node ./npm-scripts/find-unreferenced-assets.js"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "fs-extra": "^11.3.4",
    "hexo": "^7.0.0-rc1",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-alias": "^1.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-exindex": "^1.0.3",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-searchdb": "^1.4.1",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-hide-posts": "^0.4.3",
    "hexo-neat": "^1.0.9",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-stylus": "^2.1.0",
    "hexo-renderer-swig": "^2.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^0.0.3",
    "object-assign": "^4.1.1"
  },
  "devDependencies": {
    "@transnail/migrate-cli": "^1.0.0",
    "isubo": "0.0.12-alpha.7",
    "link-harvester": "^2.0.0",
    "minimist": "^1.2.8",
    "path-treeify": "^1.4.1",
    "prompts": "^2.4.2",
    "signale": "^1.4.0"
  }
}